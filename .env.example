# Copy to .env and adjust. Every setting is optional; defaults are shown.

# Analysis scope: delivery days (Europe/London, inclusive)
APP_DELIVERY_FROM=2026-01-02
APP_DELIVERY_TO=2026-02-01
# Decision cutoff on D-1, Europe/London (09:20 = EPEX GB hourly gate closure)
APP_CUTOFF_TIME=09:20
# hour_mean (mean of the two half-hours) or point (on-the-hour half-hour)
APP_ALIGNMENT=hour_mean
APP_MAPE_MIN_ACTUAL_MW=1000
APP_DEFAULT_PERCENTILE=90
# Rolling bias correction: fit on complete days D-(N+1)..D-2; ingest stores N+1 days of history
APP_CORRECTION_WINDOW_DAYS=7

# Storage
# APP_DATABASE_PATH=backend/data/wind.sqlite   (default; relative paths resolve from the working dir)
APP_DATABASE_READ_ONLY=false

# Elexon client
APP_ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1/datasets
APP_HTTP_TIMEOUT_S=30
APP_HTTP_MAX_RETRIES=4

# API
APP_CORS_ORIGINS=["http://localhost:5173"]
APP_CACHE_MAX_AGE_S=300
APP_LOG_LEVEL=INFO
# Set to enable POST /api/v1/admin/refresh (send it as the X-Refresh-Token header).
# APP_REFRESH_TOKEN=
